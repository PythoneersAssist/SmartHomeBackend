# Copy to .env for local development. In Azure these go in App Service settings.

# Auth / JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq / AI
GROQ_API_KEY=your-groq-api-key

# Database
# Local default is SQLite. For Azure use a PostgreSQL URL, e.g.:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./database.db

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Background schedulers (set to 0 to disable)
AUTOMATION_SCHEDULER_ENABLED=1
ENERGY_HISTORY_SCHEDULER_ENABLED=1
ENERGY_COST_PER_KWH=0.22
