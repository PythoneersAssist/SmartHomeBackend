# Copy to .env for local development. In Azure these go in App Service settings.

# Environment: "production" hides /docs, /redoc and /openapi.json.
# Anything else (or unset) runs in development mode with docs enabled.
ENVIRONMENT=development

# Auth / JWT
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq / AI
GROQ_API_KEY=your-groq-api-key

# Database
# Local default is SQLite. For Azure use a PostgreSQL URL, e.g.:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./database.db

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Background schedulers (set to 0 to disable)
AUTOMATION_SCHEDULER_ENABLED=1
ENERGY_HISTORY_SCHEDULER_ENABLED=1
ENERGY_COST_PER_KWH=0.22

# Household temperature simulation
# Periodically drifts thermostat readings toward active heater/AC targets,
# and toward the ambient baseline when nothing is conditioning the room.
TEMPERATURE_SIMULATION_ENABLED=1
TEMPERATURE_SIMULATION_INTERVAL_SECONDS=60
TEMPERATURE_SIMULATION_BASELINE_C=20.0
# Fraction (0-1) of the gap to the target closed each cycle.
TEMPERATURE_SIMULATION_STEP=0.1

# Email (Resend) - used for password reset and account deletion confirmation.
# Leave RESEND_API_KEY unset to log emails instead of sending them.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Frontend links embedded in transactional emails (token is appended as ?token=).
FRONTEND_RESET_URL=http://localhost:5173/reset-password
FRONTEND_DELETE_URL=http://localhost:5173/confirm-deletion

# One-off token lifetimes (minutes)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ACCOUNT_DELETION_TOKEN_EXPIRE_MINUTES=30
